# Local development values for the Docker Postgres (docker-compose.yml).
# Copy to .env and change them; never reuse these anywhere real.
ANTHROPIC_API_KEY=
TEXT2SQL_PG_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/text2sql
TEXT2SQL_READER_PASSWORD=reader-dev-only
TEXT2SQL_PG_READER_URL=postgresql://text2sql_reader:reader-dev-only@localhost:5433/text2sql
